{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/collect.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "0 20 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/detail",
      "has": [
        {
          "type": "query",
          "key": "seq",
          "value": "(?<seq>[0-9]+)"
        }
      ],
      "destination": "/exhibitions/:seq",
      "permanent": true
    },
    {
      "source": "/detail",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?view=home"
    },
    {
      "source": "/exhibitions/:seq",
      "destination": "/api/site?view=detail&seq=:seq"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site?view=sitemap"
    }
  ]
}
